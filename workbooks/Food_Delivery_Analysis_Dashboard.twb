          <datasource-dependencies datasource='federated.1rv1a7k0luntn31e47zxh0zbtumh'>
            <column caption='Actual Delivery Time Min' datatype='integer' name='[Actual_Delivery_Time_Min]' role='measure' type='quantitative' />
            <column caption='Partner Name' datatype='string' name='[Partner_Name]' role='dimension' type='nominal' />
